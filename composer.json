{
    "name": "orchestra/core",
    "description": "Core plugin providing shared infrastructure for the Orchestra plugin suite.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3",
        "dompdf/dompdf": "^3.1",
        "yahnis-elsts/plugin-update-checker": "^5.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Orchestra\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orchestra\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "fix": "phpcbf",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
