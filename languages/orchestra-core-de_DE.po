msgstr "Sprache der Website"

#: src/Ui/Language.php:104
msgid "Orchestra language"
msgstr "Orchestersprache"

#: src/Ui/Language.php:135
msgid ""
"The language of the Orchestra pages and screens. WordPress itself keeps the "
"site language."
msgstr ""
"Die Sprache der Orchesterseiten und -ansichten. WordPress selbst behält die "
"Sprache der Website."

#: src/Ui/LoginMenuItem.php:59 src/Ui/LoginShortcode.php:56
msgid "Log out"
msgstr "Ausloggen"

#: src/Ui/LoginMenuItem.php:88
msgid "Log in / Log out"
msgstr "Einloggen / Ausloggen"

#: src/Ui/LoginMenuItem.php:101
msgid "Shows \"Log in\" to visitors and \"Log out\" to logged-in users."
msgstr "Zeigt Besuchern „Einloggen“ und eingeloggten Benutzern „Ausloggen“."

#: src/Ui/LoginMenuItem.php:106
msgid "Add to Menu"
msgstr "Zum Menü hinzufügen"

#. translators: %s: user's name
#: src/Ui/LoginShortcode.php:52
#, php-format
msgid "You are logged in as %s."
msgstr "Du bist als %s eingeloggt."

#: src/Ui/LoginShortcode.php:55
msgid "Go to the orchestra pages"
msgstr "Zu den Orchesterseiten"

#: src/Ui/LoginShortcode.php:74 src/Ui/PasswordReset.php:167
